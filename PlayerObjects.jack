class PlayerObjects {
    field int gridX, gridY; //takes in the position of the Cursor on the grid to determine where to place
    field int nameID; //ID name of the type of player object we want to place, represented by numbers
                      //1 = "teto"; 2 = "Mari"
    field int currency; //will be used to keep track of how much each object costs (or adds)
                        //teto's cost = 4
                        //Mari's cost = 3
    field int counter;

    constructor PlayerObjects new(int Ax, int Ay) {
        let gridX = Ax;
        let gridY = Ay;
        let nameID = 0;
        let currency = 0;
        let counter = 0;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void setName(int Aname) {
        let nameID = Aname;
        return;
    }

    method int getNameID() {
        return nameID;
    }

    method int getRow() {
        return gridY;
    }

    //detects whether an enemy is on the same row as the instance
    method void detectEnemy(Enemies enemy) {
        var Bullet bullet;
        if (gridY = enemy.getRow()) {
            let bullet = Bullet.new(gridX, gridY);
        }
        return;
    }

